{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nome', 'x', 'y', 'cor', 'atualizadoEm'])",

        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "cor": {
          ".validate": "newData.val() === 'rosa' || newData.val() === 'laranja'"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber()"
        },

        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
