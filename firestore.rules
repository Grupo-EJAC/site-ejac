// EJAC — Regras de segurança do Firestore (camiseta + painel admin).
//
// Cole isso no Firebase Console: Firestore Database → Regras → colar
// tudo → Publicar. Isso é o que de fato valida cada envio e protege os
// dados — os módulos .js do site só fazem validação "de cortesia" no
// navegador, que qualquer um pode pular; quem barra de verdade é isto.
//
// Ninguém (nem o próprio site) pode ler os pedidos de camiseta, ou
// apagar/editar qualquer coisa, a não ser que esteja logado com um
// e-mail da lista ADMIN abaixo (login Google, feito em /admin/). É assim
// que o painel admin funciona sem senha própria nem backend nosso: quem
// autentica é o Firebase, quem autoriza é a lista de e-mails aqui embaixo.
//
// Se a lista de tamanhos mudar, atualize a função tamanhosValidos() aqui
// TAMBÉM, além do catalogos.js e do <select> no index.html.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é admin ----------

    // Coordenadores com acesso a /admin/ (ver os pedidos de camiseta com
    // WhatsApp e IP, excluir registros). Sempre em minúsculas — a comparação
    // em isAdmin() também baixa a caixa do e-mail logado, então não
    // importa como a pessoa digitou o Gmail dela originalmente.
    function emailsAdmin() {
      return [
        'diegoavanco04@gmail.com',
        'leeeandroalmeida881@gmail.com',
        'j4queline.s4nts@gmail.com',
        'lm452020@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in emailsAdmin();
    }

    // ---------- Validações compartilhadas ----------

    function nomeValido(nome) {
      return nome is string && nome.size() > 0 && nome.size() <= 80;
    }

    function whatsappValido(whatsapp) {
      return whatsapp is string && whatsapp.matches('^[0-9]{10,11}$');
    }

    // ---------- Pedido de camiseta ----------

    function tamanhosValidos() {
      return ['PP', 'P', 'M', 'G', 'GG', 'XG', 'G2', 'G3', 'G4', 'G5'];
    }

    // Qualquer um pode criar um pedido (é o formulário público), mas só
    // o painel admin consegue listar, corrigir ou excluir — os pedidos
    // têm nome + WhatsApp, não é informação pra ficar exposta.
    match /camisetaPedidos/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['nomeCompleto', 'whatsapp', 'nomeCamisa', 'numeroCamisa', 'tamanho', 'ip', 'criadoEm'])
        && nomeValido(request.resource.data.nomeCompleto)
        && whatsappValido(request.resource.data.whatsapp)
        && request.resource.data.nomeCamisa is string && request.resource.data.nomeCamisa.size() > 0 && request.resource.data.nomeCamisa.size() <= 20
        && request.resource.data.numeroCamisa is string && request.resource.data.numeroCamisa.matches('^[0-9]{1,3}$')
        && request.resource.data.tamanho in tamanhosValidos()
        && request.resource.data.ip is string && request.resource.data.ip.size() <= 45
        && request.resource.data.criadoEm == request.time;
    }

    // ---------- Ranking do Termo ----------

    // Uma marca por pessoa, por dia, por modo. Quem garante isso é o ID do
    // documento (dia_modo_uid, conferido abaixo) junto com o update que só
    // deixa mexer no nome: sem isso daria pra reenviar o dia inteiro até
    // sair um tempo bonito.
    //
    // Isto NÃO é à prova de trapaça, e é de propósito: o tempo vem do
    // navegador de quem joga e as palavras estão no próprio site. Blindar
    // exigiria um backend validando cada tentativa, o que não se paga num
    // joguinho de grupo. O que as regras garantem é o básico: ninguém
    // escreve no lugar de outro nem melhora a própria marca depois.
    function marcaValida(d) {
      return d.keys().hasOnly(['uid', 'nome', 'dia', 'modo', 'venceu', 'tentativas', 'duracaoMs', 'criadoEm'])
        && d.uid == request.auth.uid
        && nomeValido(d.nome)
        && d.nome.size() <= 20
        // o dia é o do navegador de quem joga: não dá pra comparar com
        // request.time (que é UTC) sem recusar quem joga à noite, que no
        // Brasil já é o dia seguinte lá fora
        && d.dia is string && d.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.modo == 'termo' || d.modo == 'dueto')
        && d.venceu is bool
        && d.tentativas is int && d.tentativas >= 0 && d.tentativas <= 10
        && d.duracaoMs is int && d.duracaoMs >= 0 && d.duracaoMs <= 86400000
        && d.criadoEm == request.time;
    }

    match /termoRanking/{marcaId} {
      allow read: if true;
      allow create: if request.auth != null
        && marcaValida(request.resource.data)
        && marcaId == request.resource.data.dia + '_' + request.resource.data.modo + '_' + request.auth.uid;
      // só o nome pode mudar depois (pra quem se arrependeu do apelido);
      // tempo e tentativas ficam como foram registrados
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        && nomeValido(request.resource.data.nome)
        && request.resource.data.nome.size() <= 20;
      allow delete: if isAdmin();
    }

    // ---------- GBJ (treinamento dos membros) ----------

    // O GBJ pede "usuário e senha", mas por baixo é e-mail+senha do
    // próprio Firebase Auth: o e-mail de verdade é <usuário>@gbj.ejac.local,
    // calculado sempre do mesmo jeito (ver gbj-firebase.js), nunca digitado
    // por ninguém. Só o admin cria conta — pela aba GBJ do painel, não tem
    // cadastro público — e é por isso que write aqui é só isAdmin(): o
    // próprio membro não escolhe usuário nem senha por este documento, só
    // lê o próprio nome pra ser cumprimentado.
    match /gbjMembros/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    function sessaoGbjValida(d) {
      return d.keys().hasOnly(['uid', 'modalidade', 'tempoLimiteSeg', 'rodadas', 'acertos', 'mediaTempoAcertosMs', 'motivo', 'criadoEm'])
        && d.uid == request.auth.uid
        && d.modalidade is string && d.modalidade.size() <= 40
        // 0 = "sem limite" (a pessoa treinando escolhe, não é competição)
        && d.tempoLimiteSeg is int && d.tempoLimiteSeg >= 0 && d.tempoLimiteSeg <= 120
        && d.rodadas is int && d.rodadas >= 0 && d.rodadas <= 500
        && d.acertos is int && d.acertos >= 0 && d.acertos <= d.rodadas
        // null quando não teve nenhum acerto pra tirar média
        && (d.mediaTempoAcertosMs == null || (d.mediaTempoAcertosMs is int && d.mediaTempoAcertosMs >= 0 && d.mediaTempoAcertosMs <= 3600000))
        && d.motivo in ['eliminado', 'parou']
        && d.criadoEm == request.time;
    }

    // Histórico de treino: cada um só vê e grava o próprio (list com
    // where('uid','==', o próprio uid) — a regra abaixo garante isso
    // mesmo se alguém tentar burlar o filtro no cliente). Ninguém edita
    // depois de gravado, é histórico; admin pode apagar em caso de teste
    // ou engano.
    match /gbjHistoricoSequenciaLivros/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && sessaoGbjValida(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Mesma validação (sessaoGbjValida já é genérica por modalidade), coleção
    // separada — mesmo padrão já usado pro histórico da Sequência dos Livros.
    match /gbjHistoricoQuiz/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && sessaoGbjValida(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Contestação de pergunta do Quiz: quem treina acha que o gabarito de
    // uma pergunta está errado (o documento foi digitado à mão, tem erro
    // mesmo) e avisa o coordenador. Só o admin lê — não é histórico
    // público de ninguém, é aviso pra quem vai corrigir a pergunta.
    function contestacaoValida(d) {
      return d.keys().hasOnly(['uid', 'perguntaId', 'secao', 'pergunta', 'alternativaMarcadaCerta', 'motivo', 'criadoEm'])
        && d.uid == request.auth.uid
        && d.perguntaId is string && d.perguntaId.size() <= 40
        && d.secao is string && d.secao.size() <= 20
        && d.pergunta is string && d.pergunta.size() <= 500
        && d.alternativaMarcadaCerta is string && d.alternativaMarcadaCerta.size() <= 200
        && d.motivo is string && d.motivo.size() <= 300
        && d.criadoEm == request.time;
    }

    match /gbjPerguntasContestadas/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null && contestacaoValida(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Tudo mais fica bloqueado por padrão. Isso inclui as coleções de
    // features que já saíram do site: muralTracos (mural de neon,
    // removido em 2026-08-06) e cestaContribuicoes/cestaContatos (cesta
    // básica, removida em 2026-09-16, com 27 contribuições registradas).
    // Nada disso foi apagado, só ficou inacessível — se alguma delas
    // voltar um dia, é só reabrir as regras da coleção de novo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
