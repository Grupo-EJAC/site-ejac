// EJAC — Regras de segurança do Firestore (camiseta + painel admin).
//
// Cole isso no Firebase Console: Firestore Database → Regras → colar
// tudo → Publicar. Isso é o que de fato valida cada envio e protege os
// dados — os módulos .js do site só fazem validação "de cortesia" no
// navegador, que qualquer um pode pular; quem barra de verdade é isto.
//
// Ninguém (nem o próprio site) pode ler os pedidos de camiseta, ou
// apagar/editar qualquer coisa, a não ser que esteja logado com um
// e-mail da lista ADMIN abaixo (login Google, feito em /admin/). É assim
// que o painel admin funciona sem senha própria nem backend nosso: quem
// autentica é o Firebase, quem autoriza é a lista de e-mails aqui embaixo.
//
// Se a lista de tamanhos mudar, atualize a função tamanhosValidos() aqui
// TAMBÉM, além do catalogos.js e do <select> no index.html.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é admin ----------

    // Coordenadores com acesso a /admin/ (ver os pedidos de camiseta com
    // WhatsApp e IP, excluir registros). Sempre em minúsculas — a comparação
    // em isAdmin() também baixa a caixa do e-mail logado, então não
    // importa como a pessoa digitou o Gmail dela originalmente.
    function emailsAdmin() {
      return [
        'diegoavanco04@gmail.com',
        'leeeandroalmeida881@gmail.com',
        'j4queline.s4nts@gmail.com',
        'lm452020@gmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in emailsAdmin();
    }

    // ---------- Validações compartilhadas ----------

    function nomeValido(nome) {
      return nome is string && nome.size() > 0 && nome.size() <= 80;
    }

    function whatsappValido(whatsapp) {
      return whatsapp is string && whatsapp.matches('^[0-9]{10,11}$');
    }

    // ---------- Pedido de camiseta ----------

    function tamanhosValidos() {
      return ['PP', 'P', 'M', 'G', 'GG', 'XG', 'G2', 'G3', 'G4', 'G5'];
    }

    // Qualquer um pode criar um pedido (é o formulário público), mas só
    // o painel admin consegue listar, corrigir ou excluir — os pedidos
    // têm nome + WhatsApp, não é informação pra ficar exposta.
    match /camisetaPedidos/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['nomeCompleto', 'whatsapp', 'nomeCamisa', 'numeroCamisa', 'tamanho', 'ip', 'criadoEm'])
        && nomeValido(request.resource.data.nomeCompleto)
        && whatsappValido(request.resource.data.whatsapp)
        && request.resource.data.nomeCamisa is string && request.resource.data.nomeCamisa.size() > 0 && request.resource.data.nomeCamisa.size() <= 20
        && request.resource.data.numeroCamisa is string && request.resource.data.numeroCamisa.matches('^[0-9]{1,3}$')
        && request.resource.data.tamanho in tamanhosValidos()
        && request.resource.data.ip is string && request.resource.data.ip.size() <= 45
        && request.resource.data.criadoEm == request.time;
    }

    // Tudo mais fica bloqueado por padrão. Isso inclui as coleções de
    // features que já saíram do site: muralTracos (mural de neon,
    // removido em 2026-08-06) e cestaContribuicoes/cestaContatos (cesta
    // básica, removida em 2026-09-16, com 27 contribuições registradas).
    // Nada disso foi apagado, só ficou inacessível — se alguma delas
    // voltar um dia, é só reabrir as regras da coleção de novo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
